{
  "manifest_version": 3,
  "name": "OmniModel — Pixel AI Switcher",
  "version": "0.1.0",
  "description": "Select ChatGPT, DeepSeek, Claude, Gemini, Qwen or local Ollama directly above the ChatGPT composer.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*",
    "https://api.deepseek.com/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://dashscope-intl.aliyuncs.com/*"
  ],
  "action": {
    "default_title": "OmniModel",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "omnimodel@s1nnrockk",
      "strict_min_version": "109.0"
    }
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  }
}
